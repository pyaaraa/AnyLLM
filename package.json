{
  "name": "anyllm",
  "version": "0.1.0",
  "description": "AnyLLM - Universal AI Gateway and Router (OpenRouter Alternative)",
  "license": "MIT",
  "author": "AnyLLM",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts config/config.yaml",
    "dev:client": "vite",
    "dev:server": "tsx watch src/index.ts config/config.yaml",
    "build": "vite build && tsc",
    "build:client": "vite build",
    "build:server": "tsc",
    "start": "node dist/index.js config/config.yaml",
    "deploy": "wrangler deploy --minify --tsconfig tsconfig.worker.json",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "auth:generate": "ANYLLM_CONFIG=$(base64 -w0 config/config.yaml) npx @better-auth/cli generate && mv auth-schema.ts src/models/auth.ts",
    "db:generate": "NODE_OPTIONS='--import tsx' ANYLLM_CONFIG=$(base64 -w0 config/config.yaml) drizzle-kit generate",
    "db:migrate": "ANYLLM_CONFIG=$(base64 -w0 config/config.yaml) drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@cloudflare/workers-types": "^4.20250906.0",
    "@google/genai": "^1.17.0",
    "@hono/node-server": "^1.19.1",
    "@neondatabase/serverless": "^1.0.1",
    "@upstash/redis": "^1.35.3",
    "better-auth": "^1.3.8",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.6",
    "lucide-react": "^1.70.0",
    "music-metadata": "^11.8.3",
    "openai": "^5.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.0.3",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20.19.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.6",
    "wrangler": "^4.34.0"
  }
}
